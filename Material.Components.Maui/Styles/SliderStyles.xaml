<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Material.Components.Maui.Styles.SliderStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Material.Components.Maui">

    <Style x:Key="PrimarySliderStyle" TargetType="views:Slider">
        <Setter Property="HeightRequest" Value="48" />
        <Setter Property="MinimumTrackColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="MaximumTrackColor" Value="{DynamicResource SurfaceVariantColor}" />
        <Setter Property="ThumbColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="ActiveMinimumTrackColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="ActiveThumbColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="TrackHeight" Value="4" />
        <Setter Property="ThumbRadius" Value="10" />
        <Setter Property="UpdateValueOnRelease" Value="True" />
        <Setter Property="ShowValueBubble" Value="True" />
        <Setter Property="AnimatedProgress" Value="True" />
    </Style>

</ResourceDictionary>