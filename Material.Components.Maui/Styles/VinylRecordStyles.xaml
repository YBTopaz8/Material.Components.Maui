<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary
    x:Class="Material.Components.Maui.Styles.VinylRecordStyles"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:Material.Components.Maui">

    <Style x:Key="StandardVinylRecordStyle" TargetType="views:VinylRecordView">
        <Setter Property="WidthRequest" Value="240" />
        <Setter Property="HeightRequest" Value="240" />
        <Setter Property="HorizontalOptions" Value="Center" />
        <Setter Property="VerticalOptions" Value="Center" />
        <Setter Property="CenterColor" Value="{DynamicResource PrimaryColor}" />
        <Setter Property="RPM" Value="33.33" />
    </Style>

</ResourceDictionary>